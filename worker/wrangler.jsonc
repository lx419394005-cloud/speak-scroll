{
  "name": "speak-scroll",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speak-scroll",
      "database_id": "21c83a58-64e2-40d1-85e0-9777359739b4"
    }
  ],
  "observability": {
    "enabled": true
  }
}
